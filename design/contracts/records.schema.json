{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.euclas.invalid/contracts/records.schema.json",
  "title": "Euclas cross-component record projections v1",
  "oneOf": [
    {
      "$ref": "#/$defs/committed_work"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/artifact_version"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/maintenance_operation"
    },
    {
      "$ref": "#/$defs/goal"
    },
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/responsibility"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/acceptance"
    }
  ],
  "$defs": {
    "work": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "root_unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_type": {
          "const": "work"
        },
        "work_revision": {
          "type": "integer",
          "minimum": 1
        },
        "owner_position_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verifier": {
                "enum": [
                  "deterministic",
                  "independent_review",
                  "human_judgment"
                ]
              },
              "required_evidence_kind": {
                "type": "string",
                "minLength": 1
              },
              "pass_condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description",
              "verifier",
              "required_evidence_kind",
              "pass_condition"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "status": {
          "enum": [
            "draft",
            "clarifying",
            "ready",
            "executing",
            "verifying",
            "awaiting_acceptance",
            "accepted",
            "failed",
            "cancelled"
          ]
        },
        "source_locale": {
          "type": "string",
          "minLength": 1
        },
        "output_locale": {
          "type": "string",
          "minLength": 1
        },
        "blocked_reason": {
          "enum": [
            null,
            "decision",
            "authorization",
            "dependency",
            "provider",
            "budget",
            "recovery"
          ]
        },
        "result_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "criteria_revision": {
          "type": "integer",
          "minimum": 1
        },
        "execution_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "committed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "responsibility_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "required_child": {
          "type": "boolean"
        },
        "source_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "predecessor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "id",
        "instance_id",
        "root_unit_id",
        "unit_id",
        "schema_version",
        "revision",
        "created_at",
        "updated_at",
        "record_type",
        "work_revision",
        "owner_position_id",
        "title",
        "scope",
        "criteria",
        "status",
        "source_locale",
        "output_locale",
        "blocked_reason",
        "result_revision"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": {
              "enum": [
                "draft",
                "clarifying",
                "cancelled"
              ]
            }
          },
          "type": "object",
          "required": [
            "status"
          ]
        },
        {
          "properties": {
            "status": {
              "enum": [
                "ready",
                "executing",
                "verifying",
                "awaiting_acceptance",
                "accepted",
                "failed"
              ]
            },
            "criteria": {
              "type": "array",
              "minItems": 1
            }
          },
          "type": "object",
          "required": [
            "status",
            "criteria"
          ]
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "root_unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_type": {
          "const": "run"
        },
        "work_id": {
          "type": "string",
          "format": "uuid"
        },
        "work_revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "assignment_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "waiting",
            "recovering",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "executor_type": {
          "type": "string",
          "minLength": 1
        },
        "executor_version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "grant_snapshot_ref": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "instance_id",
        "root_unit_id",
        "unit_id",
        "schema_version",
        "revision",
        "created_at",
        "updated_at",
        "record_type",
        "work_id",
        "work_revision",
        "actor_id",
        "assignment_id",
        "attempt",
        "lease_epoch",
        "status",
        "executor_type",
        "executor_version",
        "capabilities",
        "grant_snapshot_ref"
      ],
      "additionalProperties": false
    },
    "artifact_version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "root_unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_type": {
          "const": "artifact_version"
        },
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "staged",
            "verified",
            "available",
            "rejected"
          ]
        },
        "source_locale": {
          "type": "string",
          "minLength": 1
        },
        "storage_ref": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "$ref": "#/$defs/artifact_presentation"
        },
        "content_encoding": {
          "enum": [
            "jsonb_text_v1",
            "raw_utf8_v1",
            "raw_binary_v1"
          ],
          "description": "Explicit encoding for governed structured artifacts, uploaded UTF-8 Markdown, or generated office bytes; no missing-encoding compatibility mode."
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "uploaded"
                },
                "uploaded_by_actor_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "kind",
                "uploaded_by_actor_id"
              ],
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/generated_document_provenance"
            }
          ]
        }
      },
      "required": [
        "id",
        "instance_id",
        "root_unit_id",
        "unit_id",
        "schema_version",
        "revision",
        "created_at",
        "updated_at",
        "record_type",
        "artifact_id",
        "content_hash",
        "media_type",
        "size_bytes",
        "status",
        "source_locale",
        "storage_ref",
        "content_encoding"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "Governed immutable JSONB structured artifact; explicit jsonb_text_v1 encoding. Used for canonical structured content and trusted human verification statements.",
          "type": "object",
          "properties": {
            "id": {},
            "instance_id": {},
            "root_unit_id": {},
            "unit_id": {},
            "schema_version": {},
            "revision": {},
            "created_at": {},
            "updated_at": {},
            "record_type": {},
            "artifact_id": {},
            "content_hash": {},
            "media_type": {},
            "size_bytes": {},
            "status": {},
            "source_locale": {},
            "storage_ref": {},
            "presentation": {},
            "content_encoding": {
              "const": "jsonb_text_v1"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Canonical uploaded Markdown version; only durable available raw bytes.",
          "type": "object",
          "properties": {
            "content_encoding": {
              "const": "raw_utf8_v1"
            },
            "media_type": {
              "const": "text/markdown"
            },
            "status": {
              "const": "available"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64000
            },
            "provenance": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "uploaded"
                },
                "uploaded_by_actor_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "kind",
                "uploaded_by_actor_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "content_encoding",
            "provenance"
          ]
        },
        {
          "type": "object",
          "description": "Available generated DOCX/PDF with admitted producer provenance; separate from human-uploaded source content.",
          "properties": {
            "content_encoding": {
              "const": "raw_binary_v1"
            },
            "media_type": {
              "enum": [
                "application/pdf",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
              ]
            },
            "status": {
              "const": "available"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10485760
            },
            "provenance": {
              "$ref": "#/$defs/generated_document_provenance"
            }
          },
          "required": [
            "content_encoding",
            "provenance"
          ]
        }
      ]
    },
    "report": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "root_unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_type": {
          "const": "report"
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "data_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "id",
        "instance_id",
        "root_unit_id",
        "unit_id",
        "schema_version",
        "revision",
        "created_at",
        "updated_at",
        "record_type",
        "locale",
        "data_cutoff",
        "generated_at",
        "result",
        "evidence_refs",
        "risks",
        "next_actions",
        "human_decisions"
      ],
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository_scope"
        },
        {
          "$ref": "#/$defs/content_scope"
        }
      ]
    },
    "repository_scope": {
      "type": "object",
      "properties": {
        "repository_connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "base_commit": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": "object",
          "properties": {
            "minor_units": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "enforcement": {
              "enum": [
                "hard",
                "estimated"
              ]
            }
          },
          "required": [
            "minor_units",
            "currency",
            "enforcement"
          ],
          "additionalProperties": false
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "repository_connection_id",
        "base_commit",
        "allowed_paths",
        "excluded_paths",
        "allowed_actions",
        "max_tokens",
        "max_cost",
        "deadline"
      ],
      "additionalProperties": false
    },
    "content_scope": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "content"
        },
        "source_artifact_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "enum": [
              "model.generate",
              "artifact.read",
              "artifact.write"
            ]
          },
          "uniqueItems": true
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": "object",
          "properties": {
            "minor_units": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "enforcement": {
              "enum": [
                "hard",
                "estimated"
              ]
            }
          },
          "required": [
            "minor_units",
            "currency",
            "enforcement"
          ],
          "additionalProperties": false
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "source_artifact_version_ids",
        "allowed_actions",
        "max_tokens",
        "max_cost",
        "deadline"
      ],
      "additionalProperties": false
    },
    "maintenance_operation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "install",
            "update",
            "backup",
            "restore",
            "migrate",
            "takeover"
          ]
        },
        "phase": {
          "enum": [
            "requested",
            "preflight",
            "staging",
            "quiescing",
            "checkpointing",
            "applying",
            "verifying",
            "awaiting_activation",
            "activating",
            "rolling_back",
            "blocked",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "outcome": {
          "enum": [
            null,
            "succeeded",
            "rolled_back",
            "failed",
            "cancelled"
          ]
        },
        "initiator_actor_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_deployment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "target_deployment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "checkpoint_backup_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "release_manifest_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_dispatch_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "target_dispatch_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "last_safe_phase": {
          "type": "string",
          "minLength": 1
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "stage_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "detail_code": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "phase",
              "at",
              "detail_code"
            ],
            "additionalProperties": false
          }
        },
        "record_type": {
          "const": "maintenance_operation"
        }
      },
      "required": [
        "schema_version",
        "id",
        "instance_id",
        "created_at",
        "updated_at",
        "revision",
        "kind",
        "phase",
        "outcome",
        "initiator_actor_id",
        "source_deployment_id",
        "target_deployment_id",
        "checkpoint_backup_id",
        "release_manifest_hash",
        "source_dispatch_enabled",
        "target_dispatch_enabled",
        "last_safe_phase",
        "error_code",
        "decision_ref",
        "stage_history",
        "record_type"
      ],
      "additionalProperties": false
    },
    "artifact_presentation": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "structured",
            "export",
            "import_reading"
          ]
        },
        "source_artifact_version_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source_content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transform_version": {
          "type": [
            "string",
            "null"
