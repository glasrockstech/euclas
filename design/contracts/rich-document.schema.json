{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_locale": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "source_content",
              "summary",
              "explanation"
            ]
          },
          "parts": {
            "$ref": "message.schema.json#/properties/parts"
          },
          "source_locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_artifact_version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "source_content_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "locator_kind": {
                  "enum": [
                    "page",
                    "slide",
                    "section"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_artifact_version_id",
                "source_content_hash",
                "locator_kind",
                "locator"
              ],
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "role",
          "parts",
          "source_locations",
          "warnings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_locale",
    "title",
    "summary",
    "sections"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.euclas.invalid/contracts/rich-document.schema.json"
}
