          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "profile_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "profile_revision": {
              "$ref": "common.schema.json#/$defs/revision"
            },
            "profile_hash": {
              "$ref": "common.schema.json#/$defs/hash"
            },
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
