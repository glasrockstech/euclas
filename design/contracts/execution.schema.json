        "parameters_schema_version": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "parameters_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "recipient_or_endpoint_hash": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_limit_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
