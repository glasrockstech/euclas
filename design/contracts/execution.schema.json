            "$ref": "common.schema.json#/$defs/uuid"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "workflow_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
