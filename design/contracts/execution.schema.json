    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "quality": {
              "enum": [
                "measured",
                "estimated"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "quality",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "quality": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "quality",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "budget_dimension": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "money_minor",
            "tokens",
            "model_calls",
            "cpu_ms",
            "memory_bytes",
            "concurrent_runs"
