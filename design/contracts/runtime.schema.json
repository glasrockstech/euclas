        "installation_marker_hash": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_safe_stage": {
          "enum": [
            "planned",
            "staging",
            "database_initialized",
            "schema_applied",
            "marker_published",
            "verified"
          ]
        },
        "receipt_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "$ref": "common.schema.json#/$defs/instant"
        }
      },
      "required": [
        "operation_id",
        "instance_id",
        "controller_id",
        "generation",
        "data_location_id",
        "data_root_identity_hash",
        "baseline_id",
        "migration_manifest_hash",
