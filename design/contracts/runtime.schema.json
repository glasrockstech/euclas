{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.euclas.invalid/contracts/runtime.schema.json",
  "title": "Minimum-profile CP5 native runtime protocol v1",
  "$comment": "mTLS peer authentication is outside JSON. Overlap-first update preserves an authenticated UI before old UI exit; expiry aborts preparation, not running work.",
  "$defs": {
    "limits": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "max_frame_bytes": {
          "const": 262144
        },
        "nonce_validity_seconds": {
          "const": 60
        },
        "relaunch_intent_seconds": {
          "const": 300
        },
        "update_mode": {
          "const": "overlap_before_old_ui_exit"
        },
        "heartbeat_interval_seconds": {
          "const": 5
        },
        "peer_loss_fence_seconds": {
          "const": 15
        }
      },
      "required": [
        "protocol_version",
        "max_frame_bytes",
        "nonce_validity_seconds",
        "relaunch_intent_seconds",
        "update_mode",
        "heartbeat_interval_seconds",
        "peer_loss_fence_seconds"
      ],
      "additionalProperties": false
    },
    "version_set": {
      "type": "object",
      "properties": {
        "ui_manifest_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "core_protocol_version": {
          "const": 1
        },
        "supervisor_protocol_version": {
          "const": 1
        },
        "worker_envelope_version": {
          "const": 1
        },
        "checkpoint_versions": {
          "type": "array",
          "items": {
            "const": 1
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "baseline_id": {
          "const": "euclas-d92-v1"
        },
        "schema_revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "harness_profile_hashes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/hash"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "ui_manifest_hash",
        "core_protocol_version",
        "supervisor_protocol_version",
        "worker_envelope_version",
        "checkpoint_versions",
        "baseline_id",
        "schema_revision",
        "harness_profile_hashes"
      ],
      "additionalProperties": false
    },
    "runtime_status": {
      "type": "object",
      "properties": {
        "instance_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "controller_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "ownership_epoch": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "state": {
          "enum": [
            "stopped",
            "starting",
            "ready",
            "recovering",
            "maintenance",
            "needs_attention",
            "stopping"
          ]
        },
        "app_lifetime": {
          "enum": [
            "open",
            "authorized_update_relaunch",
            "closed"
          ]
        },
        "stop_generation": {
          "$ref": "common.schema.json#/$defs/epoch"
        },
        "version_set": {
          "$ref": "#/$defs/version_set"
        },
        "database_ready": {
          "type": "boolean"
        },
        "core_ready": {
          "type": "boolean"
        },
        "identity_ready": {
          "type": "boolean"
        },
        "storage_ready": {
          "type": "boolean"
        },
        "reconciliation_ready": {
          "type": "boolean"
        },
        "worker_ready": {
          "type": "boolean"
        },
        "dispatch_enabled": {
          "type": "boolean"
        },
        "operation_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        },
        "live_ui_client_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "instance_id",
        "controller_id",
        "ownership_epoch",
        "revision",
        "state",
        "app_lifetime",
        "stop_generation",
        "version_set",
        "database_ready",
        "core_ready",
        "identity_ready",
        "storage_ready",
        "reconciliation_ready",
        "worker_ready",
        "dispatch_enabled",
        "operation_id",
        "reason_codes",
        "live_ui_client_ids"
      ],
      "additionalProperties": false
    },
