          "code": {
            "type": "string",
            "minLength": 1
          },
          "message_key": {
            "type": "string",
            "minLength": 1
          },
          "safe_params": {
            "type": "object"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object"
          }
