            "type": "boolean"
          }
        },
        "required": [
          "expected_revision",
          "scheduled_instant",
          "manual"
        ],
        "additionalProperties": false
      },
      "CommandResponse": {
        "type": "object",
        "properties": {
          "command_id": {
            "type": "string",
            "format": "uuid"
          },
          "resource_id": {
            "type": "string",
