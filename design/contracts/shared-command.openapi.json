            "type": "string",
            "minLength": 1
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Criterion"
            }
          },
          "owner_position_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_message_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "responsibility_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "output_locale": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "required_child": {
            "type": "boolean"
          }
        },
        "required": [
          "expected_revision",
          "title",
          "scope",
          "criteria",
          "owner_position_id",
          "source_message_ids",
          "project_id",
          "responsibility_id",
          "output_locale"
        ],
        "additionalProperties": false
      },
      "Criterion": {
