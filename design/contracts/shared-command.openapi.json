{
  "openapi": "3.1.0",
  "info": {
    "title": "Euclas shared command definitions",
    "version": "1.0.0",
    "description": "Referenced schemas only, not a second public command catalog. Current operations are published by their owning OpenAPI packet."
  },
  "paths": {},
