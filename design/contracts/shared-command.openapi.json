      "WorkEvidenceCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "result_revision": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceInput"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "expected_revision",
          "result_revision",
          "evidence"
        ],
        "additionalProperties": false,
        "description": "Record trusted evidence against an already frozen Result while Work is executing or verifying; does not advance Work state. Current work.verify authority required."
      },
      "EvidenceCommandResponse": {
        "type": "object",
        "properties": {
          "command_id": {
            "type": "string",
            "format": "uuid"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
