          "result_revision": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "command_id",
          "resource_id",
          "revision",
          "status",
          "event_ids",
          "request_id",
          "result_revision",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "description": "Exact Result-bound evidence receipt. revision is the new aggregate revision; evidence_ids is the cumulative current registered evidence set for this Result, including earlier records, in stable order. Same-key authorized replay returns the original IDs/revision without reissuance. Later additions use a new command and expected revision. No other Result or inaccessible evidence is included."
      }
