      "ResponsibilitiesByidResumeCommand": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "review_rule": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReviewRule"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "expected_revision",
          "review_rule"
        ],
        "additionalProperties": false
      },
      "ReviewRule": {
        "type": "object",
        "properties": {
          "frequency": {
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "local_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "weekday": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 7
          },
          "catch_up": {
            "enum": [
              "coalesce"
            ],
            "description": "Initial Desktop profile: coalesce all missed occurrences into at most one authorized review."
          }
        },
        "required": [
          "frequency",
          "local_time",
          "timezone",
          "weekday",
          "catch_up"
        ],
        "additionalProperties": false
      },
