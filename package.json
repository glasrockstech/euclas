{
  "name": "euclas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": "26.13.0", "pnpm": "12.16.1" },
  "scripts": {
    "build": "tsc -p packages/contracts/tsconfig.build.json",
    "contracts:generate": "node packages/contracts/scripts/generate.ts",
    "contracts:check": "node packages/contracts/scripts/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages/contracts --max-warnings 0",
    "test": "node --test packages/contracts/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.9.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
